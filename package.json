{
  "name": "exit",
  "version": "1.0.0",
  "private": true,
  "description": "Sasstify frontend template is a purpose-built frontend template designed to seamlessly transform Loveable Dev’s AI-generated code into a production-ready static web app — optimized for lightning-fast deployment, scalability, and simplicity.",
  "homepage": "https://github.com/Sasstify-AI-Research/sasstify-frontend-template#readme",
  "bugs": {
    "url": "https://github.com/Sasstify-AI-Research/sasstify-frontend-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sasstify-AI-Research/sasstify-frontend-template.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "eslint.config.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.js",
    "build:clean": "rm -rf .vite-cache dist && vite build && node scripts/post-build.js",
    "build:analyze": "ANALYZE=true vite build && node scripts/post-build.js",
    "create:page": "node scripts/create-page.js",
    "create:component": "node scripts/create-component.js",
    "create:ui-component": "node scripts/create-ui-component.js",
    "create:block": "node scripts/create-block.js",
    "add:shadcn": "node scripts/add-shadcn-component.js",
    "manage:registry": "node scripts/manage-shadcn-registry.js",
    "list:registry": "node scripts/list-registry-components.js",
    "fetch:annotations": "node scripts/fetch-registry-annotations.js",
    "delete:page": "node scripts/delete-page.js",
    "delete:component": "node scripts/delete-component.js",
    "delete:ui-component": "node scripts/delete-ui-component.js",
    "delete:block": "node scripts/delete-block.js",
    "analyze:components": "node scripts/analyze-components.js",
    "analyze:blocks": "node scripts/analyze-blocks.js",
    "analyze:ui-components": "node scripts/analyze-ui-components.js",
    "analyze:pages": "node scripts/analyze-pages.js",
    "analyze:deps": "node scripts/analyze-deps.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "@tsparticles/engine": "^3.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^4.1.17",
    "terser": "^5.44.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^2.1.8"
  }
}
